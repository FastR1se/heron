# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Инструменты
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Артефакты прогонов: хранилище версионирует их само, в git они не попадают.
# Медиа для записки (docs/media) — исключение, они версионируются.
/store/
/outputs/
/artifacts/
*.mcap
*.npz
*.onnx
*.ckpt
*.pt

# Среда и ОС
.env
.DS_Store
Thumbs.db
desktop.ini

# Редакторы
.idea/
.vscode/

# Локальные кэши инструментов: на C места нет (RULES.md)
/.uv-cache/
/.uv-python/
# Временные каталоги тестов и сверок — тоже на D (CLAUDE.md), не в профиле пользователя.
/.pytest-tmp/
/_scratch/

# Порождаемые среды: производная величина рядом с исходной не хранится (ADR-0010).
/generated/

# Вендорские описания — вход, но не наш: хранится источник и коммит, а не файлы.
# Загружаются скриптом рядом с профилем (examples/robots/*/fetch_description.py).
/examples/robots/*/vendor/

# Документация и исходники производителей, прочитанные при сверке фактов. Чужие файлы:
# в журнале записывается, откуда и какой версии, а не они сами.
/_vendor_src/

# Рабочие копии агентов ассистента разработки: ветки сливаются в main, сами копии — нет.
/.claude/worktrees/
# Настройки ассистента: общие (.claude/settings.json) версионируются, машинные — нет.
# В локальных лежат абсолютные пути этой машины: кэши и временное на D (RULES.md).
/.claude/settings.local.json
/.npm-cache/
