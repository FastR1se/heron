# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/

# Инструменты
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# Артефакты прогонов: хранилище версионирует их само, в git они не попадают.
# Медиа для записки (docs/media) — исключение, они версионируются.
/store/
/outputs/
/artifacts/
*.mcap
*.npz
*.onnx
*.ckpt
*.pt

# Среда и ОС
.env
.DS_Store
Thumbs.db
desktop.ini

# Редакторы
.idea/
.vscode/

# Локальные кэши инструментов: на C места нет (RULES.md)
/.uv-cache/
/.uv-python/

# Порождаемые среды: производная величина рядом с исходной не хранится (ADR-0010).
/generated/

# Вендорские описания — вход, но не наш: хранится источник и коммит, а не файлы.
# Загружаются скриптом рядом с профилем (examples/robots/*/fetch_description.py).
/examples/robots/*/vendor/
