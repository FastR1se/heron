<?xml version="1.0"?>
<!--
  Описание кинематики опорного манипулятора rest_arm.

  Вход платформы (ADR-0009). Пример существует ради второго класса интерфейса:
  робот принимает команды целиком, а не потоком, и контракт объявляет углы в
  ГРАДУСАХ. URDF по спецификации всегда в радианах, поэтому сверка лимитов идёт
  с переводом единиц, и именно этот путь проверяется на этом файле.

  Пределы модели чуть шире профиля: ±180° = ±3.1416 рад против ±3.15 здесь.
-->
<robot name="rest_arm">

  <material name="shell">
    <color rgba="0.25 0.55 0.75 1.0"/>
  </material>

  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0.05"/>
      <mass value="1.5"/>
      <inertia ixx="0.0031" ixy="0" ixz="0" iyy="0.0031" iyz="0" izz="0.0047"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05"/>
      <geometry><cylinder radius="0.07" length="0.10"/></geometry>
    </collision>
  </link>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0 0 0.10"/>
      <mass value="1.0"/>
      <inertia ixx="0.0037" ixy="0" ixz="0" iyy="0.0037" iyz="0" izz="0.0008"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10"/>
      <geometry><box size="0.05 0.05 0.20"/></geometry>
    </collision>
  </link>

  <link name="elbow_link">
    <inertial>
      <origin xyz="0 0 0.09"/>
      <mass value="0.8"/>
      <inertia ixx="0.0022" ixy="0" ixz="0" iyy="0.0022" iyz="0" izz="0.0005"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.09"/>
      <geometry><box size="0.045 0.045 0.18"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.09"/>
      <geometry><box size="0.045 0.045 0.18"/></geometry>
    </collision>
  </link>

  <link name="wrist_link">
    <inertial>
      <origin xyz="0 0 0.03"/>
      <mass value="0.3"/>
      <inertia ixx="0.0002" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.03"/>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.03"/>
      <geometry><cylinder radius="0.03" length="0.06"/></geometry>
    </collision>
  </link>

  <joint name="j1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="0 0 0.10"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.15" upper="3.15" effort="80" velocity="1.0"/>
  </joint>

  <joint name="j2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0 0 0.20"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.58" upper="1.58" effort="80" velocity="1.0"/>
  </joint>

  <joint name="j3" type="revolute">
    <parent link="elbow_link"/>
    <child link="wrist_link"/>
    <origin xyz="0 0 0.18"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.58" upper="1.58" effort="40" velocity="1.0"/>
  </joint>

  <joint name="j4" type="revolute">
    <parent link="wrist_link"/>
    <child link="tool_link"/>
    <origin xyz="0 0 0.06"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.15" upper="3.15" effort="20" velocity="1.0"/>
  </joint>

  <link name="tool_link">
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0.015"/>
      <geometry><box size="0.05 0.03 0.03"/></geometry>
      <material name="shell"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.015"/>
      <geometry><box size="0.05 0.03 0.03"/></geometry>
    </collision>
  </link>

</robot>
